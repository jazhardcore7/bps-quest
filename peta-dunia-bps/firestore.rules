rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function allowlistDoc() {
      return get(/databases/$(database)/documents/allowedEmails/$(userEmail()));
    }

    function isEmailAllowed() {
      return exists(/databases/$(database)/documents/allowedEmails/$(userEmail()));
    }

    // Users Collection
    match /users/{userId} {
      // Signed-in users may read any user doc
      allow read: if isSignedIn();

      // Create only if:
      // - uid == auth.uid
      // - allowedEmails/{lowercased auth email} exists
      // - unit and role match the allowlist document
      // - email matches auth token email
      // - initial stats: xp == 0, xpWeek == 0, xpMonth == 0, level == 1
      allow create: if isOwner(userId)
                    && isEmailAllowed()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.unit == allowlistDoc().data.unit
                    && request.resource.data.role == allowlistDoc().data.role
                    && request.resource.data.xp == 0
                    && request.resource.data.xpWeek == 0
                    && request.resource.data.xpMonth == 0
                    && request.resource.data.level == 1;

      // Clients may NOT update role, unit or email
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'unit', 'email']);

      allow delete: if false;
    }

    // Allowed Emails Collection
    match /allowedEmails/{emailId} {
      // A signed-in user may only get the doc of their own lowercased email; no listing, no writes
      allow get: if isSignedIn() && userEmail() == emailId;
      allow list, write: if false;
    }

    // Everything else denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
